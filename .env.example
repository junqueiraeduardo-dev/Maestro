# ---- Supabase (Free Tier) -> Project Settings > API ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave service_role: o RLS está ligado SEM policy pública,
# então só o backend (com service_role) consegue ler/gravar.
SUPABASE_KEY=

# ---- Gemini (Free Tier) -> https://aistudio.google.com/apikey ----
GEMINI_API_KEY=

# ---- Portão de acesso (senha compartilhada do cliente) ----
# Sem isto o app NEGA TUDO (fail-closed). Escolha uma senha forte.
# Esta é a senha dos "filhos" (uso diário da equipe).
ACCESS_PASSWORD=

# Senha do "pai" (administrador). OPCIONAL:
#  - vazio  => quem tem ACCESS_PASSWORD é o dono (acesso total)
#  - definido => ACCESS_PASSWORD vira "filho" (sem excluir/gestão);
#    só quem usa esta senha vê a Gestão e pode excluir.
ACCESS_PASSWORD_ADMIN=

# ---- Pagamento (Mercado Pago) — checkout HOSPEDADO, cartão nunca toca aqui ----
# Painel MP -> Suas integrações -> Credenciais de produção.
MP_ACCESS_TOKEN=
# MP -> Webhooks -> "Assinatura secreta" (valida que o webhook é do MP).
MP_WEBHOOK_SECRET=
# URL pública do app (back_urls e notification_url). Ex.: https://maestro-j369.onrender.com
APP_URL=

# ---- E-mail da chave Premium (Resend) -> resend.com/api-keys ----
RESEND_API_KEY=
# Remetente verificado no Resend. Ex.: "Maestro <no-reply@seudominio.com>"
MAIL_FROM=

# Porta do servidor Express (opcional; padrão 3000)
PORT=3000
