# ---- Supabase (Free Tier) -> Project Settings > API ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave service_role: o RLS está ligado SEM policy pública,
# então só o backend (com service_role) consegue ler/gravar.
SUPABASE_KEY=

# ---- Gemini (Free Tier) -> https://aistudio.google.com/apikey ----
GEMINI_API_KEY=

# ---- Portão de acesso (senha compartilhada do cliente) ----
# Sem isto o app NEGA TUDO (fail-closed). Escolha uma senha forte.
ACCESS_PASSWORD=

# Porta do servidor Express (opcional; padrão 3000)
PORT=3000
